# Multi-Tenant Bot Configuration Environment Variables
# Copy this file to .env and fill in your actual API keys and tokens

# ===== GLOBAL/DEFAULT CREDENTIALS =====
# These are used as fallbacks when bots don't specify their own

# Global OpenAI credentials (fallback)
GLOBAL_OPENAI_API_KEY=sk-your-global-openai-key-here

# Global Anthropic credentials (fallback)
GLOBAL_ANTHROPIC_API_KEY=sk-ant-your-global-anthropic-key-here

# Default HTTP API key (for bots that don't specify their own)
DEFAULT_HTTP_API_KEY=default-http-api-key-123

# Default Telegram bot token (for bots that don't specify their own)
DEFAULT_TELEGRAM_BOT_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ===== BOT-SPECIFIC CREDENTIALS =====
# Each bot can have its own isolated credentials

# Support Bot - Customer service with dedicated resources
SUPPORT_ANTHROPIC_API_KEY=sk-ant-support-team-key-here
SUPPORT_HTTP_API_KEY=support-http-secure-key-456
SUPPORT_TELEGRAM_BOT_TOKEN=1111111111:SUP-PORT1234Bot-Token-Here

# Sales Bot - Sales team with separate billing
SALES_OPENAI_API_KEY=sk-sales-team-openai-key-here
SALES_HTTP_API_KEY=sales-http-secure-key-789
SALES_TELEGRAM_BOT_TOKEN=2222222222:SAL-ES1234Bot-Token-Here

# HR Bot - HR department with restricted access
HR_ANTHROPIC_API_KEY=sk-ant-hr-department-key-here
HR_HTTP_API_KEY=hr-confidential-key-secret

# Note: dev_bot and demo_bot use global credentials
# Note: hr_bot uses global Telegram token but custom HTTP/Anthropic keys
